# Settings of the iGrant.io platform for Docker Compose.
#
# "make env" copies this file to .env (git ignores .env). Change your copy,
# then run "make check". Rules for the values:
# - One KEY=value line for each setting, with no spaces around "=". Both
#   docker compose and the scripts of this folder read the file.
# - Do not put a secret in this file. "make secrets" writes the secrets to
#   the folder secrets/.
# - A value in your shell has priority over the value in .env.

# --- Database engine ------------------------------------------------------------

# DB_ENGINE: the database engine of ALL components (the api and its OpenID
# provider, consent, the wallet, the migrations and the read-only users).
#   Allowed: postgresql (PostgreSQL 18), the only supported engine.
#   Default: postgresql.
DB_ENGINE=postgresql

# --- Public URLs ----------------------------------------------------------------
# The URLs that browsers, mobile wallets and other systems use: the URLs
# of your reverse proxy (README.md, "Reverse proxy"). Use https:// for a
# production installation and for mobile wallets. No "/" at the end.

# API_PUBLIC_URL: the public URL of the API (your reverse proxy sends it to
# API_PORT).
#   Example: https://api.example.com
#   Default: http://localhost:8080 (this computer only).
API_PUBLIC_URL=http://localhost:8080

# WALLET_PUBLIC_URL: the public URL of the organisation wallet (your
# reverse proxy sends it to WALLET_PORT).
#   Example: https://wallet.example.com
#   Default: http://localhost:8090 (this computer only).
WALLET_PUBLIC_URL=http://localhost:8090

# DASHBOARD_PUBLIC_URL: the public URL of the dashboard (your reverse
# proxy sends it to DASHBOARD_PORT).
#   Example: https://dashboard.example.com
#   Default: http://localhost:3000 (this computer only).
DASHBOARD_PUBLIC_URL=http://localhost:3000

# --- Host ports -----------------------------------------------------------------

# PUBLISH_ADDRESS: the IP address of the host ports.
#   Allowed: an IP address of this computer; 127.0.0.1 (only this computer,
#   for a reverse proxy on the same computer) or 0.0.0.0 (all interfaces,
#   for a reverse proxy on another computer).
#   Default: 127.0.0.1.
PUBLISH_ADDRESS=127.0.0.1

# API_PORT, WALLET_PORT, DASHBOARD_PORT: the host ports of the API (the
# auth gateway), of the public wallet routes and of the dashboard.
#   Allowed: a free TCP port, 1 to 65535.
#   Defaults: 8080, 8090, 3000.
API_PORT=8080
WALLET_PORT=8090
DASHBOARD_PORT=3000

# --- Reverse proxy --------------------------------------------------------------

# CLIENT_ADDRESS_HEADER: the request header in which your reverse proxy
# sets the IP address of the client (one address, not a list). The gateway
# uses the client address for the rate limits and for the IP allow-lists of
# the API keys.
#   Example: X-Real-IP (nginx: proxy_set_header X-Real-IP $remote_addr).
#   Default: empty (the gateway uses the address of its TCP peer, which is
#   the address of the reverse proxy or of Docker).
# Set it only when every request comes through your reverse proxy and the
# proxy always replaces the header.
CLIENT_ADDRESS_HEADER=

# --- Feature gate ---------------------------------------------------------------

# FEATURES_ENFORCE: the feature gate of the gateway (Features.enforce). With
# true, the gateway refuses a route of a product feature that is off for
# the organisation of the credential (403, errorKey feature_disabled). A
# platform admin sets the features of each organisation in the dashboard.
# With false, the gateway refuses no route for a feature: use it for an
# emergency, or for the first start of a release with the gate on an
# installation that exists, until you have checked the features of its
# organisations (README.md, "Change to the release with the platform
# operator").
#   Allowed: true or false.
#   Default: true.
FEATURES_ENFORCE=true

# --- Limits of the installation -------------------------------------------------
# Empty: the api and the wallet get no key and use their default (100). Set
# a value only with the images of the release with the input limits
# (PLATFORM_TAG): an api or a wallet of an earlier release does not know the
# key and does not start. The largest value is 100. An installation with more
# than 100 organisations or organisation wallets keeps them, but it cannot make
# a new organisation.

# MAX_ORGANISATIONS: the most organisations of the installation
# (Limits.maxOrganisations of the api). The create of one more organisation
# gets 409 organisation_limit_reached; the organisations that exist stay.
#   Allowed: empty, or 1 to 100.
#   Default: empty (the api uses 100).
MAX_ORGANISATIONS=

# MAX_ORGANISATION_WALLET_UNITS: the most organisation wallet units of the
# wallet provider (wallet_unit.organisation_wallet_units_max of the wallet).
# The create of one more organisation wallet (a new organisation) gets 409
# organisation_wallet_unit.limit_reached; the units that exist stay.
#   Allowed: empty, or 1 to 100.
#   Default: empty (the wallet uses 100).
MAX_ORGANISATION_WALLET_UNITS=

# --- E-mail ---------------------------------------------------------------------
# The api sends e-mails (for example the invitations of new admins and the
# password reset). The SMTP server is yours.

# SMTP_HOST: the host name of your SMTP server.
#   Default: empty (the api sends no e-mail).
SMTP_HOST=

# SMTP_PORT: the port of your SMTP server. The api uses STARTTLS when the
# server offers it.
#   Default: 587.
SMTP_PORT=587

# SMTP_USERNAME: the user name of the SMTP login. "make secrets" asks for
# its password and writes it to secrets/api/smtp-password.
#   Default: empty (no SMTP authentication).
SMTP_USERNAME=

# SMTP_FROM: the sender address of the e-mails.
#   Example: no-reply@example.com
#   Default: empty. Required when SMTP_HOST is set.
SMTP_FROM=

# --- Images ---------------------------------------------------------------------
# The images of the iGrant.io components: <IMAGE_REGISTRY>/<repository>:
# <PLATFORM_TAG>, with the repositories api (api core and webhook handler),
# gateway, consent-management-backend, eudi-wallet and dashboard (README.md,
# "Settings").

# IMAGE_REGISTRY: the registry of the iGrant.io images for customers, the
# same default as the Helm chart (global.imageRegistry). Change it to use
# your mirror.
#   Default: europe-docker.pkg.dev/jenkins-189019/igrantio
IMAGE_REGISTRY=europe-docker.pkg.dev/jenkins-189019/igrantio

# PLATFORM_TAG: the release tag of all iGrant.io images (one release). The
# dashboard also shows it as its version.
#   Set the release tag: "2026.10.x" is a placeholder, and make check stops
#   until you replace it with the tag of your release (for example
#   2026.10.1).
PLATFORM_TAG=2026.10.x

# The images of the dependencies. Change them only to use a mirror of the
# same versions (the versions that the components are tested with).
POSTGRES_IMAGE=postgres:18.6
NATS_IMAGE=nats:2.14.10-alpine@sha256:311da47e2f31c26e99c623cd78d486a1e8ab039c49b32652770bb91a4f70512e
OPENBAO_IMAGE=openbao/openbao:2.7.1@sha256:6d2b93856e3fcf7b18ad855a0b51eaba474dc8b79cf554379ea32034797d2acf
# Valkey with its digest (the image of the Helm chart, redis.image).
VALKEY_IMAGE=valkey/valkey:8.1.10-alpine@sha256:081c2f5cb575efc901aa80ff9cdbd1ec6a301682fd35e1ebb4b0990a4a4a8507

# --- Built-in test CA -----------------------------------------------------------
# The built-in test CA of the wallet issues test certificates for development
# and testing (up to three test root CAs for each organisation: mdoc,
# provider, access). They are not on any
# trusted list (README.md, "Settings").

# TEST_CA_ENABLED: the built-in test CA is on (kms.test_ca.enabled). Switch
# it off when the installation must not offer it.
#   Allowed: true or false.
#   Default: true.
TEST_CA_ENABLED=true

# TEST_CA_LEAF_VALIDITY_DAYS: the validity in days of a test certificate
# when the request gives none (kms.test_ca.leaf_validity_days). The largest
# validity of the preset caps it (for example 457 days for an mdoc document
# signer).
#   Allowed: 1 to 3650.
#   Default: 365.
TEST_CA_LEAF_VALIDITY_DAYS=365

# AUDIT_RETENTION_YEARS: the years that the audit log of the wallet keeps
# the events of each data scope (audit.retention_years). wallet-migrate
# drops the older months only after a verified export, and Compose has no
# audit bucket, so no month is dropped (README.md, "Audit log").
#   Allowed: 1 to 999.
#   Default: 7.
AUDIT_RETENTION_YEARS=7

# --- Derived settings -------------------------------------------------------------
# Do not change these lines: they follow from the settings above.

# COMPOSE_PROFILES: the database server of DB_ENGINE.
COMPOSE_PROFILES=${DB_ENGINE}
