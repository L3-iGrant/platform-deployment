# Settings of the iGrant.io platform for Docker Compose.
#
# "make env" copies this file to .env (git ignores .env). Edit your copy,
# then run "make check". Rules:
# - One KEY=value line per setting, with no spaces around "=". Both
#   docker compose and the scripts in this folder read the file.
# - No secrets here. "make secrets" writes them to the folder secrets/.
# - A value set in your shell overrides the value in .env.

# --- Database engine ------------------------------------------------------------

# DB_ENGINE: the database engine of ALL components (the api and its OpenID
# provider, consent, the wallet, the migrations and the read-only users).
#   Allowed: postgresql (PostgreSQL 18), the only supported engine.
#   Default: postgresql.
DB_ENGINE=postgresql

# --- Public URLs ----------------------------------------------------------------
# The URLs that browsers, mobile wallets and other systems use, so the URLs
# of your reverse proxy (README.md, "Reverse proxy"). Use https:// in
# production and for mobile wallets. No "/" at the end.

# API_PUBLIC_URL: the public URL of the API (your reverse proxy forwards it
# to API_PORT).
#   Example: https://api.example.com
#   Default: http://localhost:8080 (this computer only).
API_PUBLIC_URL=http://localhost:8080

# WALLET_PUBLIC_URL: the public URL of the organisation wallet (your
# reverse proxy forwards it to WALLET_PORT).
#   Example: https://wallet.example.com
#   Default: http://localhost:8090 (this computer only).
WALLET_PUBLIC_URL=http://localhost:8090

# DASHBOARD_PUBLIC_URL: the public URL of the dashboard (your reverse
# proxy forwards it to DASHBOARD_PORT).
#   Example: https://dashboard.example.com
#   Default: http://localhost:3000 (this computer only).
DASHBOARD_PUBLIC_URL=http://localhost:3000

# --- Host ports -----------------------------------------------------------------

# PUBLISH_ADDRESS: the IP address that the host ports listen on.
#   Allowed: an IP address of this computer; 127.0.0.1 (this computer only,
#   for a reverse proxy on the same computer) or 0.0.0.0 (all interfaces,
#   for a reverse proxy on another computer).
#   Default: 127.0.0.1.
PUBLISH_ADDRESS=127.0.0.1

# API_PORT, WALLET_PORT, DASHBOARD_PORT: the host ports of the API (the
# auth gateway), the public wallet routes and the dashboard.
#   Allowed: a free TCP port, 1 to 65535.
#   Defaults: 8080, 8090, 3000.
API_PORT=8080
WALLET_PORT=8090
DASHBOARD_PORT=3000

# --- Reverse proxy --------------------------------------------------------------

# CLIENT_ADDRESS_HEADER: the request header in which your reverse proxy
# sends the client IP address (one address, not a list). The gateway uses
# the client address for rate limits and for the IP allow-lists of API keys.
#   Example: X-Real-IP (nginx: proxy_set_header X-Real-IP $remote_addr).
#   Default: empty (the gateway uses its TCP peer address, which is the
#   address of the reverse proxy or of Docker).
# Set it only when every request comes through your reverse proxy and the
# proxy always replaces the header.
CLIENT_ADDRESS_HEADER=

# --- Feature gate ---------------------------------------------------------------

# FEATURES_ENFORCE: the gateway's feature gate (Features.enforce). With true,
# the gateway refuses a route of a product feature that is off for the
# credential's organisation (403, errorKey feature_disabled). A platform
# admin sets the features of each organisation in the dashboard. With false,
# the gateway refuses no route for a feature: use this in an emergency, or
# for the first start of an existing installation on a release with the
# gate, until you have checked the features of its organisations.
#   Allowed: true or false.
#   Default: true.
FEATURES_ENFORCE=true

# --- Consent --------------------------------------------------------------------

# CONSENT_ENABLED: "true" installs consent management (data agreements and
# consent records): the services consent, consent-migrate,
# consent-read-access, api-read-access-consent and wallet-read-access-consent
# (the Compose profile consent; README.md, "Consent"). Empty: no consent, the
# same default as the Helm chart. The installation then has only the
# organisation wallet: the gateway answers 404 service_not_installed on the
# consent routes, and the dashboard shows no consent area.
# After a change, run make secrets (the NATS nkey of consent), make check
# and make up.
#   Allowed: empty or true (not false: any value turns the profile on).
#   Default: empty (no consent).
CONSENT_ENABLED=

# --- Limits of the installation -------------------------------------------------
# When empty, the api and the wallet get no key and use their default (100).
# The maximum is 100. An installation with more than 100 organisations or
# organisation wallets keeps them, but cannot create a new organisation.

# MAX_ORGANISATIONS: the maximum number of organisations in the installation
# (Limits.maxOrganisations of the api). Creating one more gets 409
# organisation_limit_reached; existing organisations stay.
#   Allowed: empty, or 1 to 100.
#   Default: empty (the api uses 100).
MAX_ORGANISATIONS=

# MAX_ORGANISATION_WALLET_UNITS: the maximum number of organisation wallet
# units of the wallet provider (wallet_unit.organisation_wallet_units_max of
# the wallet). Creating one more organisation wallet (a new organisation)
# gets 409 organisation_wallet_unit.limit_reached; existing units stay.
#   Allowed: empty, or 1 to 100.
#   Default: empty (the wallet uses 100).
MAX_ORGANISATION_WALLET_UNITS=

# --- E-mail ---------------------------------------------------------------------
# The api sends e-mails (for example admin invitations and password resets)
# through your own SMTP server.

# SMTP_HOST: the host name of your SMTP server.
#   Default: empty (the api sends no e-mail).
SMTP_HOST=

# SMTP_PORT: the port of your SMTP server. The api uses STARTTLS when the
# server offers it.
#   Default: 587.
SMTP_PORT=587

# SMTP_USERNAME: the SMTP login user name. "make secrets" asks for its
# password and writes it to secrets/api/smtp-password.
#   Default: empty (no SMTP authentication).
SMTP_USERNAME=

# SMTP_FROM: the sender address of the e-mails.
#   Example: no-reply@example.com
#   Default: empty. Required when SMTP_HOST is set.
SMTP_FROM=

# --- Images ---------------------------------------------------------------------
# The iGrant.io component images are <IMAGE_REGISTRY>/<repository>:
# <PLATFORM_TAG>, with the repositories api (api core and webhook handler),
# gateway, consent-management-backend, eudi-wallet and dashboard (README.md,
# "Settings").

# IMAGE_REGISTRY: the registry of the iGrant.io images, the same default as
# the Helm chart (global.imageRegistry). Change it to use your mirror.
#   Default: europe-docker.pkg.dev/jenkins-189019/igrant-customers
IMAGE_REGISTRY=europe-docker.pkg.dev/jenkins-189019/igrant-customers

# PLATFORM_TAG: the release tag of all iGrant.io images (one release). The
# dashboard also shows it as its version.
#   Set your release tag: "2026.11.x" is a placeholder, and make check stops
#   until you replace it (for example with 2026.11.4).
PLATFORM_TAG=2026.11.x

# The dependency images. Change them only to use a mirror of the same
# versions (the components are tested with these versions).
POSTGRES_IMAGE=postgres:18.7@sha256:9f4fd4aa918f52ae3d6f3b687f1de90d8f867cd4d520021545a9a50c120eae3b
NATS_IMAGE=nats:2.14.10-alpine@sha256:311da47e2f31c26e99c623cd78d486a1e8ab039c49b32652770bb91a4f70512e
OPENBAO_IMAGE=openbao/openbao:2.7.2@sha256:5046911075e137e154ce49ab051502f4ec7cf367d484ae4a4dce665d9b90561f
# Valkey, pinned by digest (the Helm chart's image, redis.image).
VALKEY_IMAGE=valkey/valkey:8.1.11-alpine@sha256:2602ace2be6569bc2bbb06f873776516ab9089821525be34f4305c67eb9db02a

# --- Built-in test CA -----------------------------------------------------------
# The wallet's built-in test CA issues test certificates for development and
# testing (up to three test root CAs per organisation: mdoc, provider,
# access). They are on no trusted list (README.md, "Settings").

# TEST_CA_ENABLED: turns the built-in test CA on (kms.test_ca.enabled). Turn
# it off when the installation must not offer it.
#   Allowed: true or false.
#   Default: true.
TEST_CA_ENABLED=true

# TEST_CA_LEAF_VALIDITY_DAYS: the validity in days of a test certificate
# when the request gives none (kms.test_ca.leaf_validity_days). The preset's
# maximum validity caps it (for example 457 days for an mdoc document
# signer).
#   Allowed: 1 to 3650.
#   Default: 365.
TEST_CA_LEAF_VALIDITY_DAYS=365

# AUDIT_RETENTION_YEARS: how many years the wallet's audit log keeps the
# events of each data scope (audit.retention_years). wallet-migrate drops
# older months only after a verified export, and Compose has no audit
# bucket, so no month is ever dropped (README.md, "Audit log").
#   Allowed: 1 to 999.
#   Default: 7.
AUDIT_RETENTION_YEARS=7

# --- Derived settings -------------------------------------------------------------
# Do not change these lines: they follow from the settings above.

# COMPOSE_PROFILES: starts the database server of DB_ENGINE, and the
# consent services with CONSENT_ENABLED.
COMPOSE_PROFILES=${DB_ENGINE}${CONSENT_ENABLED:+,consent}
