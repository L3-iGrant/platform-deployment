# Values for DB_ENGINE=postgresql. docker-compose.yaml loads this file after
# .env. Do not edit it; change DB_ENGINE in .env instead.
# The database server port on the Compose network.
DB_PORT=5432
# The superuser that creates the databases, the read-only users and the
# wallet's database roles.
DB_ADMIN_USER=postgres
# The database-init image (it has the psql client).
DB_CLIENT_IMAGE=${POSTGRES_IMAGE}
